    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "data = {'Day':['Mon','Tue','Wed'],'Marks':[50,75,90]}\n",
    "df=pd.DataFrame(data)\n",
    "plt.plot(df['Day'],df['Marks'],marker='o',color='blue')\n",
    "plt.title('My Marks Over Days')\n",
    "plt.show()"
   ]
